  "interactionBehavior": {
    "summary": "Container is a layout primitive with no hover, press, focus, or keyboard behaviour of its own — it does not take focus and inherits the parent's cursor. Every Container is a `<Surface>` (default `mode=\"ghost\"`), so it always stamps `data-surface` and opts descendants into the token-remapping cascade even when you never pass `surface`. Pass `surface` / `appearance` to change that context (and the fill); pass `as` for the element. Interactivity has to come from children or from HTML attributes you forward yourself — Container does not add `tabIndex`, `cursor`, or a halo."
  },
  "importPath": "@jds4/oneui-react",
  "figma": {
    "componentKey": "jds-container-v4"
  },
