  "interactionBehavior": {
    "summary": "A purely decorative layer, not a click-to-dismiss target. It is `aria-hidden` with `pointer-events: none`, so every press, hover, and focus falls through to whatever sits underneath. Dialog, Modal, BottomSheet, and OverlaySideSheet paint their own `--Scrim` backdrops; those backdrops are what dismiss overlays. This component never registers a click handler.",
    "press": [
      "Clicks and taps pass through. There is no `onClick`, no dismiss callback, and no cursor change.",
      "Use it over media or behind content that must stay interactive. Do not use it as a Modal-style outside-press surface."
    ]
  },
